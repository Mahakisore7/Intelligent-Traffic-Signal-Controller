<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- 1. Define the Vehicle Types -->
    <!-- This is our standard car. The imgFile attribute has been removed to use SUMO's default shape. -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" maxSpeed="15" />
    
    <!-- This is our special ambulance. We give it a blue color and higher speed for easy identification. -->
    <vType id="ambulance" accel="3.0" decel="5.0" sigma="0.5" length="6" maxSpeed="20" color="blue" />

    <!-- 2. Define all possible Routes (Paths through the intersection) -->
    <!-- Straight Routes -->
    <route id="W_E" edges="W_in E_out" />
    <route id="E_W" edges="E_in W_out" />
    <route id="N_S" edges="N_in S_out" />
    <route id="S_N" edges="S_in N_out" />
    <!-- Right Turn Routes -->
    <route id="W_N" edges="W_in N_out" />
    <route id="N_E" edges="N_in E_out" />
    <route id="E_S" edges="E_in S_out" />
    <route id="S_W" edges="S_in W_out" />
    <!-- Left Turn Routes -->
    <route id="W_S" edges="W_in S_out" />
    <route id="S_E" edges="S_in E_out" />
    <route id="E_N" edges="E_in N_out" />
    <route id="N_W" edges="N_in W_out" />

    <!-- 3. Generate the Traffic Flow (unbalanced scenario for testing) -->
    <!-- Main Road (Busy): ~600 cars total on the West->East path -->
    <flow id="main_flow_straight" type="car" route="W_E" begin="0" end="1800" number="500" />
    <flow id="main_flow_right" type="car" route="W_N" begin="0" end="1800" number="50" />
    <flow id="main_flow_left" type="car" route="W_S" begin="0" end="1800" number="50" />
    
    <!-- Side Road (Quiet): ~70 cars total on the North->South path -->
    <flow id="side_flow_straight" type="car" route="N_S" begin="0" end="1800" number="50" />
    <flow id="side_flow_right" type="car" route="N_E" begin="0" end="1800" number="10" />
    <flow id="side_flow_left" type="car" route="N_W" begin="0" end="1800" number="10" />

    <!-- 4. Add the single ambulance for the preemption test -->
    <!-- This specific vehicle will appear at exactly 150 seconds on the North road. -->
    <vehicle id="ambulance_1" type="ambulance" route="N_S" depart="150" />

</routes>